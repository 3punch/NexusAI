# NexusAI environment template — copy to `.env` and adjust.
# NEVER commit a real .env; CI and teammates always start from this file.

# --- Backend (read by app.core.config.Settings) ---
NEXUSAI_SECRET_KEY=dev-only-secret-change-me
NEXUSAI_ENVIRONMENT=development
# SQLite in dev; PostgreSQL in production, e.g. postgresql+psycopg://user:pass@host/db
NEXUSAI_DATABASE_URL=sqlite:///./nexusai.db
# mock (no external calls) | openai
NEXUSAI_LLM_PROVIDER=mock
NEXUSAI_OPENAI_API_KEY=
NEXUSAI_OPENAI_MODEL=gpt-4o-mini

# --- Frontend (read by Vite; must be prefixed VITE_ to reach the client) ---
VITE_API_BASE=/api/v1
