{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"root install skipped — the frontend installs its own dependencies in buildCommand\"",
  "buildCommand": "cd frontend && npm install --no-fund --no-audit && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/docs/(.*)", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/redoc", "destination": "/api/index.py" },
    { "source": "/((.*))", "destination": "/index.html" }
  ]
}
